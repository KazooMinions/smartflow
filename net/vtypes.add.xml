<?xml version="1.0" encoding="UTF-8"?>
<!-- Phnom Penh vehicle mix: average of JICA's 17 roadside count stations (JICA 2023, Table 5.3.11).
     The JICA route file uses these vehicle types directly with the same shares.
     Motorbikes and tuk-tuks use SUMO's sublane model, so they ride side by side and filter to the stop line. -->
<additional>
    <vTypeDistribution id="mix">
        <vType id="moto"   probability="0.662" vClass="motorcycle" length="1.9" width="0.75" minGap="0.8" accel="3.0" decel="6.0" tau="0.8" sigma="0.5" maxSpeed="12.5" speedFactor="normc(1.0,0.1,0.7,1.3)" latAlignment="arbitrary" minGapLat="0.25" guiShape="motorcycle" color="0,170,255"/>
        <vType id="car"    probability="0.166" vClass="passenger"  length="4.4" width="1.75" minGap="1.2" accel="2.4" decel="4.5" tau="1.0" sigma="0.5" maxSpeed="11.1" speedFactor="normc(1.0,0.1,0.7,1.3)" color="230,230,230"/>
        <vType id="tuktuk" probability="0.121" vClass="passenger"  length="2.9" width="1.35" minGap="1.0" accel="1.6" decel="4.0" tau="1.0" sigma="0.5" maxSpeed="8.3"  speedFactor="normc(1.0,0.1,0.7,1.3)" latAlignment="arbitrary" minGapLat="0.3" color="255,200,0"/>
        <vType id="truck"  probability="0.051" vClass="truck"      length="7.5" width="2.4"  minGap="2.0" accel="1.1" decel="4.0" tau="1.2" sigma="0.5" maxSpeed="9.7"  speedFactor="normc(1.0,0.1,0.7,1.3)" color="200,80,60"/>
    </vTypeDistribution>
</additional>
