<?xml version="1.0" encoding="UTF-8"?>
<!-- 40 km/h (11.11 m/s). N = Monivong North, S = Monivong South, E = Charles de Gaulle north-east, W = Charles de Gaulle south-west.
     X_in = traffic arriving from side X; X_out = traffic leaving towards side X.
     Lane counts are an EFFECTIVE-WIDTH calibration, not painted lanes: OpenStreetMap tags Monivong as 2 lanes each way and
     Charles de Gaulle as 2 (widening to 4 near the junction on the south-west side). Phnom Penh motorbikes use the whole
     carriageway, and with 2 SUMO lanes the junction cannot pass the traffic JICA counted, so we use 4 and 3. -->
<edges>
    <edge id="N_in"  from="N" to="C" numLanes="4" speed="11.11"/>
    <edge id="S_in"  from="S" to="C" numLanes="4" speed="11.11"/>
    <edge id="E_in"  from="E" to="C" numLanes="3" speed="11.11"/>
    <edge id="W_in"  from="W" to="C" numLanes="3" speed="11.11"/>
    <edge id="N_out" from="C" to="N" numLanes="4" speed="11.11"/>
    <edge id="S_out" from="C" to="S" numLanes="4" speed="11.11"/>
    <edge id="E_out" from="C" to="E" numLanes="3" speed="11.11"/>
    <edge id="W_out" from="C" to="W" numLanes="3" speed="11.11"/>
</edges>
